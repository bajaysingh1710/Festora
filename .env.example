# ==============================================================================
# Festora - Environment Configuration
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# NOTE: Never commit .env or .env.local with real secrets to version control.
# ==============================================================================

# Google Gemini API Key (Optional)
# Used for genuine Google Gemini 2.0 Flash LLM integration in the AI Event Copilot.
# If omitted, Festora automatically operates using its autonomous built-in smart
# planner fallback engine, and users can also provide their key via the in-app
# AI Settings modal (persisted locally in browser storage).
# Get your API key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Default Gemini Model (Optional)
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
VITE_GEMINI_MODEL=gemini-2.0-flash

# Base Application URL (Optional)
# Used for generating shareable guest invitations and QR pass links.
# Defaults to http://localhost:3000 in local development.
VITE_APP_URL=http://localhost:3000

